<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_order-fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="order-fulfilment" name="E-Commerce Order Processing and Fulfilment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Order" name="Order received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="order-form" />
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validate" name="Validate order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-validate" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Order valid?" default="Flow_Valid_No" />
    <bpmn:endEvent id="End_Invalid" name="Order invalid" />
    <bpmn:serviceTask id="Task_Inventory" name="Check inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-check-inventory" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Stock" name="Stock available?" default="Flow_Stock_No" />
    <bpmn:endEvent id="End_NoStock" name="Cannot fulfil: insufficient stock" />
    <bpmn:serviceTask id="Task_Total" name="Calculate order total">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-calculate-total" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Priority" name="Determine priority (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order_priority" resultVariable="priorityResult" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_HighValue" name="High-value order?" default="Flow_HV_No" />
    <bpmn:userTask id="Task_Verify" name="Manual order verification (Tasklist)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="order-verification-form" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verified" name="Verified?" default="Flow_Ver_No" />
    <bpmn:endEvent id="End_Cancelled" name="Order cancelled by reviewer" />
    <bpmn:serviceTask id="Task_Payment" name="Charge payment (REST Connector)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8082/api/payments/charge" target="url" />
          <zeebe:input source="={orderRef: orderRef, paymentToken: paymentToken, amount: orderTotal, currency: &#34;INR&#34;}" target="body" />
          <zeebe:input source="10" target="connectionTimeoutInSeconds" />
          <zeebe:input source="10" target="readTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="paymentResponse" />
          <zeebe:header key="resultExpression" value="={paymentStatus: response.body.status, transactionId: response.body.transactionId, paymentMessage: response.body.message}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Payment approved?" default="Flow_Pay_No" />
    <bpmn:endEvent id="End_Declined" name="Payment declined" />
    <bpmn:serviceTask id="Task_Fulfil" name="Reserve stock &#38; create shipment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-fulfil" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Fulfilled" name="Order fulfilled" />
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_Order" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Validate" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Valid_No" name="No" sourceRef="Gateway_Valid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="F3" name="Yes" sourceRef="Gateway_Valid" targetRef="Task_Inventory">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=validationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Inventory" targetRef="Gateway_Stock" />
    <bpmn:sequenceFlow id="Flow_Stock_No" name="No" sourceRef="Gateway_Stock" targetRef="End_NoStock" />
    <bpmn:sequenceFlow id="F5" name="Yes" sourceRef="Gateway_Stock" targetRef="Task_Total">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockStatus = "IN_STOCK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Total" targetRef="Task_Priority" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Priority" targetRef="Gateway_HighValue" />
    <bpmn:sequenceFlow id="F8" name="Yes" sourceRef="Gateway_HighValue" targetRef="Task_Verify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 50000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HV_No" name="No" sourceRef="Gateway_HighValue" targetRef="Task_Payment" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Verify" targetRef="Gateway_Verified" />
    <bpmn:sequenceFlow id="Flow_Ver_No" name="No" sourceRef="Gateway_Verified" targetRef="End_Cancelled" />
    <bpmn:sequenceFlow id="F10" name="Yes" sourceRef="Gateway_Verified" targetRef="Task_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verificationDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Payment" targetRef="Gateway_Payment" />
    <bpmn:sequenceFlow id="F12" name="Approved" sourceRef="Gateway_Payment" targetRef="Task_Fulfil">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Pay_No" name="Declined" sourceRef="Gateway_Payment" targetRef="End_Declined" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Fulfil" targetRef="End_Fulfilled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-fulfilment">
      <bpmndi:BPMNShape id="StartEvent_Order_di" bpmnElement="StartEvent_Order">
        <dc:Bounds x="132" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
